# Public application URL, e.g. http://localhost:3000 or https://roxanne.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (required for persistent production data and production owner login)
# Enable Google under Supabase Auth > Providers and add your deployed
# /auth/callback URL to Supabase Auth > URL Configuration > Redirect URLs.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ElevenLabs Scribe speech-to-text (required in production)
ELEVENLABS_API_KEY=
ELEVENLABS_SCRIBE_MODEL_ID=scribe_v2

# Qwen via an OpenAI-compatible endpoint (required in production)
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Devin follow-up operator (required in production)
DEVIN_API_KEY=
DEVIN_API_BASE_URL=https://api.devin.ai
DEVIN_ORG_ID=
DEVIN_POLL_TIMEOUT_MS=60000

# Google OAuth and APIs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# WhatsApp relay. Baileys requires a persistent service (for example Waddle on Railway),
# so Vercel calls that service instead of opening a long-lived socket itself.
WHATSAPP_RELAY_URL=
WHATSAPP_RELAY_TOKEN=
# Railway-only; use a different random value of at least 32 bytes.
WHATSAPP_AUTH_ENCRYPTION_KEY=
WHATSAPP_ALLOWED_RECIPIENT=601154444038
WHATSAPP_WORKSPACE_KEY=roxanne
# Direct Postgres URL used only by the persistent Baileys worker.
DATABASE_URL=
PORT=3001

# Agora RTC
NEXT_PUBLIC_AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# Serverless Redis (Upstash REST). A hosted endpoint is required on Vercel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Safety and defaults
APP_TIMEZONE=Asia/Kuala_Lumpur
ACTION_APPROVAL_SECRET=
DEMO_USER_EMAIL=nathanhor2001@gmail.com
# Optional: pin persistence to an existing Supabase Auth user UUID.
DEMO_USER_ID=
